# Generates a C++ source holding the live map's files, so mt-ingest serves
# them from memory: one binary, no files to install, and no path on disk a
# request could reach.
#
#   cmake -DWEB_DIR=... -DOUT=... -P embed_web.cmake
set(files index.html app.js style.css land.json vendor/leaflet/leaflet.js vendor/leaflet/leaflet.css
          vendor/leaflet/LICENSE)
set(src "// Generated by cmake/embed_web.cmake from web/. Do not edit.\n")
string(APPEND src "#include \"maritime/serve/web_assets.hpp\"\n\nnamespace maritime::serve {\n\nnamespace {\n")
set(entries "")
set(i 0)
foreach(f IN LISTS files)
  file(READ "${WEB_DIR}/${f}" content)
  string(FIND "${content}" ")MTWEB\"" clash)
  if(NOT clash EQUAL -1)
    message(FATAL_ERROR "${f} contains the raw-string delimiter")
  endif()
  if(f MATCHES "\\.html$")
    set(type "text/html; charset=utf-8")
  elseif(f MATCHES "\\.js$")
    set(type "text/javascript; charset=utf-8")
  elseif(f MATCHES "\\.css$")
    set(type "text/css; charset=utf-8")
  elseif(f MATCHES "\\.json$")
    set(type "application/json")
  else()
    set(type "text/plain; charset=utf-8")
  endif()
  # Split into chunks: compilers limit the length of a single string literal.
  string(LENGTH "${content}" len)
  string(APPEND src "constexpr const char* kFile${i}[] = {\n")
  set(pos 0)
  while(pos LESS len)
    string(SUBSTRING "${content}" ${pos} 60000 chunk)
    string(APPEND src "R\"MTWEB(${chunk})MTWEB\",\n")
    math(EXPR pos "${pos} + 60000")
  endwhile()
  string(APPEND src "};\n")
  string(APPEND entries "    add(\"/${f}\", \"${type}\", kFile${i});\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND src "\n}  // namespace\n\nconst std::map<std::string, Asset>& web_assets() {\n")
string(APPEND src "    static const std::map<std::string, Asset> assets = [] {\n")
string(APPEND src "        std::map<std::string, Asset> m;\n")
string(APPEND src "        static std::vector<std::string> storage;  // joined chunks, alive for the program\n")
string(APPEND src "        storage.reserve(${i});\n")
string(APPEND src "        const auto add = [&](const char* path, const char* type, const auto& chunks) {\n")
string(APPEND src "            std::string s;\n")
string(APPEND src "            for (const char* c : chunks) s += c;\n")
string(APPEND src "            storage.push_back(std::move(s));\n")
string(APPEND src "            m[path] = Asset{type, storage.back()};\n")
string(APPEND src "        };\n${entries}")
string(APPEND src "        return m;\n    }();\n    return assets;\n}\n\n}  // namespace maritime::serve\n")
file(WRITE "${OUT}.tmp" "${src}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
